# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-5
DATABASE_URL=sqlite:///./factlayer.db
UPLOAD_DIR=./uploads
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cosine similarity threshold above which two facts are sent to the LLM
# relationship classifier (0-1, higher = fewer, more confident candidates)
LINK_SIMILARITY_THRESHOLD=0.55

# How many candidate matches to consider per new fact
LINK_TOP_K=5
